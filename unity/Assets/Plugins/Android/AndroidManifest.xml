<?xml version="1.0" encoding="utf-8"?>
<!-- AVALON permissions-only overlay.
     DO NOT declare any <activity> here — Unity 6's gradle plugin disables its stock
     launcher whenever the custom main manifest declares one (even the stock name),
     which shipped an APK with android:enabled="false" and no homescreen icon (v107-v109).
     Unity injects a working MAIN/LAUNCHER UnityPlayerActivity itself when the
     custom manifest stays out of the <application> node. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
</manifest>
